# ===== 应用 =====
APP_NAME=ganluo
APP_DEBUG=true
# 后端对外访问地址，用于拼接上传图片的完整 URL
APP_URL=http://127.0.0.1:8000

# ===== 数据库 =====
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=ganluo
DB_USERNAME=root
DB_PASSWORD=

# ===== JWT =====
# 正式环境务必改成随机长字符串
JWT_SECRET=change-me-to-a-long-random-string
# token 有效期（秒），默认 7 天
JWT_TTL=604800

# ===== 微信小程序 =====
WECHAT_APPID=
WECHAT_SECRET=
